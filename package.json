{
  "name": "firefox-nextcloud-bookmarks-sync",
  "version": "4.5.14",
  "description": "Synchronise vos marques-pages Firefox avec Nextcloud",
  "main": "manifest.json",
  "scripts": {
    "start": "web-ext run",
    "build": "web-ext build",
    "lint": "web-ext lint",
    "package": "web-ext build --overwrite-dest",
    "icons": "chmod +x icons/generate_icons.sh && ./icons/generate_icons.sh"
  },
  "keywords": [
    "firefox",
    "extension",
    "webextension",
    "nextcloud",
    "bookmarks",
    "sync",
    "synchronization"
  ],
  "author": "Arka",
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/lukeskysurfer/firefox-nextcloud-bookmarks-sync/issues"
  },
  "homepage": "https://github.com/lukeskysurfer/firefox-nextcloud-bookmarks-sync#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukeskysurfer/firefox-nextcloud-bookmarks-sync.git"
  },
  "devDependencies": {
    "web-ext": "^7.6.0"
  },
  "webExt": {
    "build": {
      "overwriteDest": true
    },
    "ignoreFiles": [
      "package-lock.json",
      "package.json",
      "*.log",
      "*.txt",
      ".env*",
      ".gitea_token",
      ".web-ext-config.js",
      "web-ext-artifacts/**"
    ]
  }
}
