{
  "manifest_version": 3,
  "name": "Firefox Bookmarks Sync To Nextcloud",
  "version": "4.5.11",
  "description": "Firefox Bookmarks Sync To Nextcloud - Synchronise vos marques-pages Firefox avec Nextcloud v4.5.8 - Batch processing, Retry avec backoff, Cache des favicons, Connexion persistante",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/*.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": [
    "bookmarks",
    "storage",
    "alarms",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "https://*/index.php/apps/bookmarks/public/rest/v2/*",
    "https://*/index.php/apps/bookmarks/public/rest/v2/folder*",
    "https://*/index.php/apps/bookmarks/public/rest/v2/bookmark*",
    "https://*/index.php/apps/bookmarks/public/rest/v2/tag*",
    "https://*/index.php/apps/bookmarks/public/rest/v2/share*"
  ],
  "background": {
    "scripts": ["background/errors.js", "background/logger.js", "background/config.js", "background/cache.js", "background/batch.js", "background/bookmark_utils.js", "background/storage.js", "background/nextcloud_api.js", "background/sync.js"]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.svg",
      "32": "icons/icon-32.svg",
      "48": "icons/icon-48.svg",
      "96": "icons/icon-96.svg"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon-16.svg",
    "32": "icons/icon-32.svg",
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.svg"
  },
  "default_locale": "fr",
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-bookmarks-sync-to-nextcloud@luke.local",
      "strict_min_version": "109.0"
    }
  }
}
